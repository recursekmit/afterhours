# After Hours configuration. Copy to .env (git-ignored). Never commit real values.

# ---- required in production (NODE_ENV=production refuses to boot without the PINs)
# Console PIN (/admin). 4+ characters. Must differ from SCREEN_PIN and GATE_PIN.
ADMIN_PIN=change-me-admin
# Projector PIN (/screen). 4+ characters.
SCREEN_PIN=change-me-screen
# Door / gate coordinator PIN (/gate). 4+ characters. Must differ from ADMIN_PIN.
GATE_PIN=change-me-gate

# ---- docker-compose / Caddy
# Public hostname that points at the droplet, e.g. afterhours.example.com. HTTPS is mandatory
# (service workers, push and the camera need it). compose sets APP_URL=https://$DOMAIN for you.
DOMAIN=afterhours.example.com
# Contact email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ---- server
NODE_ENV=production
# HOST / PORT: where Node listens inside the container. Leave as is under compose.
HOST=0.0.0.0
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# SQLite file (WAL mode). Under compose this is the mounted "data" volume.
DATABASE_PATH=/data/afterhours.db
# Built web app to serve. The Dockerfile sets it; leave empty in dev (Vite serves the web app).
# WEB_DIST=/app/web/dist
# Public URL of the attendee app, used in QR codes. Compose overrides it with https://$DOMAIN.
# APP_URL=https://afterhours.example.com
EVENT_NAME=After Hours
EVENT_DATE=2026-11-21
# Attendee session lifetime in hours (1 to 72). The event is one afternoon.
SESSION_HOURS=16
# Secure cookies. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# true when behind a reverse proxy (Caddy) so rate limits see real client IPs. Compose sets it.
TRUST_PROXY=true

# ---- sign-in rate limits
# Per IP is generous because a whole college can share one NAT address.
LOGIN_IP_PER_MIN=60
# Wrong tries allowed per kit ID inside the window, then it is locked for the rest of it.
LOGIN_KIT_FAILS=5
LOGIN_KIT_WINDOW_MIN=5

# ---- web push (optional; without these, alerts still show in-app over the live stream)
# Generate once with: npm run vapid -w server   (prints a pair; keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:recurse@kmit.in
